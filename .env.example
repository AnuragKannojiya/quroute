# QuRoute Environment Configuration
# Copy this to .env and adjust as needed

# Quantum service
QUANTUM_SERVICE_URL=http://quantum-service:8001

# Backend
PORT=3000
QUANTUM_TIMEOUT_MS=15000
CACHE_TTL_MS=300000

# Fallback mode: set to "true" to use pre-computed cached results
# instead of running the live quantum solver
FALLBACK_MODE=false
